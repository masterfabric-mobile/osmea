  "about_configuration": {
    "style": "enterprise",
    "title": "About MasterFabric",
    "description": "Platform-Based Application Development Studio",
    "html_content": "<div style='padding: 24px; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;'><h1 style='color: #000000; font-size: 28px; font-weight: 600; margin-bottom: 16px;'>About MasterFabric</h1><p style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 16px;'>We are a team of mobile application development experts who excel in creating innovative solutions across multiple industries. Our expertise spans cross-platform development, seamless backend integrations, and enterprise-grade mobile solutions.</p><p style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 16px;'>We don't limit ourselves to specific sectors - instead, we embrace diverse challenges and deliver exceptional results in healthcare, fintech, e-commerce, education, and logistics.</p><h2 style='color: #000000; font-size: 22px; font-weight: 600; margin-top: 24px; margin-bottom: 12px;'>Our Expertise</h2><ul style='color: #333333; font-size: 16px; line-height: 1.8; padding-left: 24px;'><li>Cross-platform mobile development (Flutter, React Native)</li><li>Native iOS and Android development</li><li>Backend integration and API development</li><li>Enterprise-grade mobile solutions</li><li>UI/UX design and implementation</li><li>Cloud infrastructure and DevOps</li></ul><h2 style='color: #000000; font-size: 22px; font-weight: 600; margin-top: 24px; margin-bottom: 12px;'>Industries We Serve</h2><p style='color: #333333; font-size: 16px; line-height: 1.6;'>Healthcare, Fintech, E-commerce, Education, Logistics, and more.</p></div>",
    "enable_fullscreen_web_view": true,
    "show_version": true,
    "show_company_info": true,
    "company_name": "MasterFabric",
    "copyright": "© 2025 MasterFabric Inc. All rights reserved.",
    "background_color": "#FFFFFF",
    "text_color": "#000000",
    "primary_color": "#000000",
