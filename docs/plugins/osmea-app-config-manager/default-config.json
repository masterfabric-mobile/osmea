    "items": [
      {
        "question": "What is MasterFabric?",
        "answer": "<p>MasterFabric is a platform-based application development studio that specializes in creating innovative mobile solutions across multiple industries.</p>",
        "expanded_by_default": false,
        "category": null
      },
      {
        "question": "What services do you offer?",
        "answer": "<p>We offer cross-platform mobile development, native iOS and Android development, backend integration, enterprise-grade mobile solutions, UI/UX design, and cloud infrastructure services.</p>",
        "expanded_by_default": false,
        "category": null
      },
      {
        "question": "Which industries do you serve?",
        "answer": "<p>We serve healthcare, fintech, e-commerce, education, logistics, and many other industries. We don't limit ourselves to specific sectors and embrace diverse challenges.</p>",
        "expanded_by_default": false,
        "category": null
      },
      {
        "question": "How can I contact you?",
        "answer": "<p>You can reach us via email at info@masterfabric.co or through our contact form. We're always happy to discuss your project needs.</p>",
        "expanded_by_default": false,
        "category": null
      },
      {
        "question": "Do you provide ongoing support?",
        "answer": "<p>Yes, we provide comprehensive ongoing support and maintenance services for all our applications to ensure they continue to perform optimally.</p>",
        "expanded_by_default": false,
        "category": null
      }
    ]
  },
